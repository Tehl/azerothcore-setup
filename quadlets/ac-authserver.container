[Container]
ContainerName=ac-authserver
Image=localhost/acore/ac-wotlk-authserver:master
PodmanArgs=--tty
LogOpt=max-size=10m
StopTimeout=60
PublishPort=3724:3724/tcp
Volume=ac-logs.volume:/azerothcore/env/dist/logs
Volume=%h/srv/azerothcore/server/env/dist/etc:/azerothcore/env/dist/etc:ro,Z
EnvironmentFile=%h/srv/azerothcore/server/conf/dist/env.ac
Environment=TZ=Etc/UTC
Environment=AC_LOGS_DIR=/azerothcore/env/dist/logs
Environment=AC_TEMP_DIR=/azerothcore/env/dist/temp
Environment=AC_LOGIN_DATABASE_INFO=ac-database;3306;root;${DOCKER_DB_ROOT_PASSWORD};acore_auth
Network=azerothcore.network

[Service]
Restart=always
EnvironmentFile=%h/srv/azerothcore/host/.env

[Unit]
Requires=ac-database.service
After=ac-database.service