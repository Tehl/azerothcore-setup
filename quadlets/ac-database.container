[Container]
ContainerName=ac-database
Image=docker.io/library/mysql:8.4
LogOpt=max-size=10m
StopTimeout=60
Volume=ac-database-backup.volume:/tmp/backup
Volume=ac-database-data.volume:/var/lib/mysql
Volume=%h/srv/azerothcore/env/mysql:/etc/mysql/conf.d:ro,Z
Environment=TZ=Etc/UTC
Environment=MYSQL_ROOT_PASSWORD=${DOCKER_DB_ROOT_PASSWORD}
Network=azerothcore.network
Notify=healthy
HealthCmd=/usr/bin/mysql --user=root --password=$$MYSQL_ROOT_PASSWORD --execute "SHOW DATABASES;"
HealthInterval=10s
HealthRetries=3
HealthTimeout=5s
Label=docker-volume-backup.archive-pre="/bin/sh -c 'mysqldump -u root -p$$MYSQL_ROOT_PASSWORD --databases acore_auth acore_characters acore_playerbots > /tmp/backup/ac-database.sql'"
Label=docker-volume-backup.archive-post="/bin/sh -c 'rm -v /tmp/backup/ac-database.sql'"

[Service]
Restart=always
EnvironmentFile=%h/srv/azerothcore/host/.env

[Install]
WantedBy=default.target